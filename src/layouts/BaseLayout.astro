---
// Shell for every page: shared head, and for sub-pages the nav, footer and site.js.
// Slots: "head" for page CSS, default for <main>, "footer" to replace the copyright line,
// "scripts" for page JS. Set nav={false} for pages that bring their own chrome (home, 404),
// and siteCss={false} for the homepage, which carries its own stylesheet.
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Nav, { type Props as NavProps } from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

export interface Props {
  seo: SeoProps;
  nav?: NavProps | false;
  siteCss?: boolean;
}

const { seo, nav = {}, siteCss = true } = Astro.props;
const hasFooterText = Astro.slots.has('footer');
---
<!DOCTYPE html>
<html lang="en">
<head>
<Analytics />
<Seo {...seo} />
{siteCss && <link rel="stylesheet" href="/assets/site.css">}
<slot name="head" />
</head>
<body>
{nav && (
  <>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav {...nav} />
  </>
)}
<slot />
{nav && (hasFooterText ? <Footer><slot name="footer" /></Footer> : <Footer />)}
{nav && <script is:inline src="/assets/site.js"></script>}
<slot name="scripts" />
<ConsentBanner />
</body>
</html>

---
// One proof row: sector, title and problem, and one big result.
import { caseUrl, type CaseStudy } from '../data/cases';
export interface Props { study: CaseStudy; }
const { study } = Astro.props;
const [value, label] = study.results[0];
---
<a class="asc" href={caseUrl(study.slug)} data-reveal data-item data-tags={study.tags.join(' ')}>
  <span class="who">{study.sector}{study.place && <small>{study.place}</small>}</span>
  <div class="what"><h3>{study.title}</h3><p>{study.problem}</p></div>
  <span class="stat"><b data-count>{value}</b><small>{label}</small></span>
</a>

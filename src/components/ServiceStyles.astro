---
// Styles shared by the /services hub and every /services/<slug> page.
---
<style is:inline>
  .svc-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2rem;
    gap: 1px; background: var(--line);
    border: 1px solid var(--line); border-radius: 8px; overflow: hidden;
  }
  .svc-item { background: var(--navy-mid); padding: 2rem; }
  .svc-item h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.45rem; }
  .svc-item p { color: var(--text-soft); font-size: 0.95rem; line-height: 1.65; }
  a.svc-item { color: inherit; text-decoration: none; transition: background 0.3s; display: flex; flex-direction: column; }
  a.svc-item:hover { background: var(--navy-card); }
  /* A lone card on the last row spans it, so no empty cells show. */
  .svc-grid > .svc-item:last-child:nth-child(3n + 1) { grid-column: 1 / -1; }
  a.svc-item h3 { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.01em; }
  .svc-go { margin-top: auto; padding-top: 1.2rem; font-family: 'Space Mono', monospace; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue-light); }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-top: 2rem; counter-reset: step; }
  .step { border-top: 1px solid var(--line-strong); padding-top: 1.2rem; }
  .step .kicker { display: block; margin-bottom: 0.5rem; }
  .step h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.45rem; }
  .step p { color: var(--text-soft); font-size: 0.95rem; line-height: 1.65; }

  .proofs { display: grid; gap: 1.5rem; margin-top: 2rem; }
  .proof {
    display: grid; grid-template-columns: 1.6fr 1fr; gap: 2rem; align-items: center;
    background: var(--navy-card); border: 1px solid var(--line); border-radius: 8px; padding: 2rem 1.8rem;
  }
  .proof.no-stats { grid-template-columns: 1fr; }
  .proof h3 { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.4rem; letter-spacing: -0.01em; margin: 0.5rem 0 0.6rem; }
  .proof p { color: var(--text-soft); font-size: 0.95rem; line-height: 1.7; }
  .proof-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 0.4rem; color: var(--blue-light); text-decoration: none; font-weight: 600; font-size: 0.92rem; }
  .proof-link:hover { color: var(--cyan); }
  .proof-stats { display: grid; gap: 1rem; }
  .proof-stat { border-left: 2px solid var(--line-strong); padding-left: 1rem; }
  .proof-stat-num { font-family: 'Bebas Neue', sans-serif; font-size: 2.2rem; letter-spacing: 0.04em; color: var(--cyan); line-height: 1.1; }
  .proof-stat-label { font-family: 'Space Mono', monospace; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }

  .stack { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; list-style: none; }
  .stack li {
    font-family: 'Space Mono', monospace; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--blue-light); background: rgba(72,202,228,0.07); border: 1px solid rgba(72,202,228,0.18);
    padding: 0.35rem 0.75rem; border-radius: 3px;
  }

  .related { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .related a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.1rem;
    border: 1px solid var(--line-strong); border-radius: 5px; color: var(--white); text-decoration: none; font-size: 0.95rem;
  }
  .related a:hover { border-color: var(--cyan); color: var(--cyan); }

  .ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2rem; }
  .way { background: var(--navy-card); border: 1px solid var(--line); border-radius: 8px; padding: 2rem 1.8rem; }
  .way h3 { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.01em; margin: 0.5rem 0 0.6rem; }
  .way p { color: var(--text-soft); font-size: 0.95rem; line-height: 1.7; }

  @media (max-width: 1100px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
    .svc-grid > .svc-item:last-child:nth-child(3n + 1) { grid-column: auto; }
    .svc-grid > .svc-item:last-child:nth-child(2n + 1) { grid-column: 1 / -1; }
    .steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .svc-grid, .proof, .ways { grid-template-columns: 1fr; }
    .svc-grid > .svc-item:last-child { grid-column: auto; }
    .svc-item { padding: 1.6rem 1.4rem; }
    .svc-item p, .step p, .proof p, .way p { font-size: 1rem; }
    .svc-go, .stack li, .proof-stat-label { font-size: 0.75rem; }
    .proof { padding: 1.6rem 1.4rem; gap: 1.4rem; }
    .proof-stats { grid-template-columns: repeat(3, 1fr); }
    .hero-actions .btn-primary, .hero-actions .btn-outline { flex: 1 1 auto; text-align: center; }
  }
  @media (max-width: 600px) {
    .steps, .proof-stats { grid-template-columns: 1fr; }
  }
</style>

---
// Sub-page footer. Pass children to replace the default copyright line.
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();
---
<footer>
  <a href="/" class="footer-brand" aria-label="Rirote Global, home"><img src="/assets/brand/logo-dark.svg" width="198" height="64" alt="Rirote Global" loading="lazy"></a>
  <div class="footer-links"><a href="/services">Services</a><a href="/about">About</a><a href="/privacy-policy">Privacy Policy</a><a href="/privacy-policy#analytics-cookies" data-consent-open>Cookie settings</a></div>
  <SocialLinks />
  <span class="footer-copy"><slot>&copy; {year} Rirote Global. All rights reserved.</slot></span>
</footer>

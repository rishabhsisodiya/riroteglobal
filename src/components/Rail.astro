---
// The side rail: an arrow that climbs as the page scrolls, stopping on each section. Reaching the top is the
// "summit" (see site.js). Phones get a thin progress bar instead.
export interface Props {
  stops: Array<[id: string, label: string]>;
  summitLabel?: string;
}
const { stops, summitLabel = 'Let’s talk' } = Astro.props;
const last = stops.length - 1;
---
<div class="pbar" aria-hidden="true"><i></i></div>
<a class="fab" href={`#${stops[last][0]}`}>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
  {summitLabel}
</a>
<aside class="rail" aria-label="Page sections" data-summit={summitLabel}>
  <a class="rail-logo" href="/" aria-label="Rirote Global, home"><img src="/assets/brand/mark.svg" width="40" height="40" alt=""></a>
  <div class="track">
    <div class="fill"></div>
    <div class="climber" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 1 22 13h-6v10H8V13H2z"/></svg></div>
    {stops.map(([id, label], i) => (
      <a class="stop" href={`#${id}`} data-id={id} style={`top:${(1 - i / last) * 100}%`}><span>{label}</span></a>
    ))}
  </div>
</aside>

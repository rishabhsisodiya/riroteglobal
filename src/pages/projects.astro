---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseRow from '../components/CaseRow.astro';
import Crumbs from '../components/Crumbs.astro';
import Cta from '../components/Cta.astro';
import { breadcrumbs, webPage } from '../lib/schema';
import { COMPANY_STATS } from '../data/site';
import { CASES, PROBLEMS } from '../data/cases';

const seo = {
  title: 'ERP, SaaS & E-commerce Case Studies | Rirote Global',
  path: '/projects',
  description: 'Case studies in enterprise ERP, manufacturing ERP, SaaS, logistics and e-commerce: what we built, the stack, and the measured results.',
  ogDescription: 'Case studies in ERP, manufacturing, e-commerce, logistics and SaaS, with the results each business saw.',
  schema: [
    webPage({ path: '/projects', name: 'Case Studies', type: 'CollectionPage' }),
    breadcrumbs(['Home', '/'], ['Work', '/projects']),
  ],
};
const usedProblems = PROBLEMS.filter((p) => CASES.some((c) => c.tags.includes(p.id)));
---
<BaseLayout seo={seo} nav={{ current: 'projects' }}>
<main id="main">
  <section class="page-hero">
    <div class="hero-content">
      <Crumbs items={[['Home', '/'], ['Work']]} />
      <p class="eyebrow">Client Work &amp; Case Studies</p>
      <h1 class="page-title">Problems we have <span>already solved.</span></h1>
      <p class="page-sub">Software we built for businesses in ERP, manufacturing, e-commerce, logistics and SaaS, and what changed for each one.</p>
      <div class="stats">
        <div><b data-count>{COMPANY_STATS.projects.value}</b><span>{COMPANY_STATS.projects.label}</span></div>
        <div><b data-count>{COMPANY_STATS.industries.value}</b><span>{COMPANY_STATS.industries.label}</span></div>
        <div><b data-count>{COMPANY_STATS.regions.value}</b><span>{COMPANY_STATS.regions.label}</span></div>
      </div>
    </div>
  </section>

  <section class="wrap" data-filters aria-labelledby="work-title" style="padding-bottom:clamp(40px,6vw,80px)">
    <h2 class="section-title" id="work-title" style="font-size:clamp(1.6rem,3vw,2.2rem)">Selected work</h2>
    <p class="nda-note" style="margin-bottom:16px">Most client names and identifying details are withheld under NDA.</p>
    <div class="filters" role="group" aria-label="Filter by problem">
      <button class="fchip" type="button" data-key="tags" data-val="" aria-pressed="true">All</button>
      {usedProblems.map((p) => <button class="fchip" type="button" data-key="tags" data-val={p.id} aria-pressed="false">{p.label}</button>)}
    </div>
    <p class="fcount" data-filter-count data-noun="case studies" role="status"></p>
    <div class="ascents">{CASES.map((c) => <CaseRow study={c} />)}</div>
  </section>

  <Cta eyebrow="Your Project" title="Have a problem like these?" body="Tell us what you're working on and what is getting in the way. We'll get back to you as soon as we can.">
    <a href="/contact" class="btn-primary">Start a Conversation</a>
    <a href="/services" class="btn-outline">See Our Services</a>
  </Cta>
</main>
</BaseLayout>

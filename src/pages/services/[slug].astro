---
// One page per service, built from src/data/services.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import ServiceStyles from '../../components/ServiceStyles.astro';
import Updated from '../../components/Updated.astro';
import { breadcrumbs, service as serviceNode, webPage } from '../../lib/schema';
import { lastModified } from '../../lib/lastModified';
import { SERVICES, SERVICES_PATH, SERVICE_STEPS, serviceBySlug, serviceUrl, type Service } from '../../data/services';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props as { service: Service };
const path = serviceUrl(service.slug);
const updated = lastModified('src/data/services.ts', 'src/pages/services/[slug].astro');
const related = service.related.map(serviceBySlug).filter((s): s is Service => Boolean(s));

const seo = {
  title: service.metaTitle,
  path,
  description: service.description,
  ogTitle: `${service.name} — Rirote Global`,
  schema: [
    webPage({ path, name: service.name, dateModified: updated }),
    serviceNode({ name: service.name, description: service.summary, path }),
    breadcrumbs(['Home', '/'], ['Services', SERVICES_PATH], [service.name, path]),
  ],
};
---
<BaseLayout seo={seo} nav={{ current: 'services' }}>
<Fragment slot="head"><ServiceStyles /></Fragment>

<main id="main">
  <section class="page-hero">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>
    <div class="hero-content">
      <p class="eyebrow fade-up d1"><a href={SERVICES_PATH} style="text-decoration:none;">Services</a> / {service.name}</p>
      <h1 class="page-title fade-up d2">{service.heading[0]}<br><span>{service.heading[1]}</span></h1>
      <p class="page-sub fade-up d3">{service.intro}</p>
      <div class="hero-actions fade-up d4">
        <a href="/#contact" class="btn-primary">Talk to Us</a>
        <a href="/projects" class="btn-outline">See Our Work</a>
      </div>
      <Updated date={updated} class="fade-up d4" />
    </div>
  </section>

  <section class="section" aria-labelledby="includes-title">
    <div class="section-header">
      <h2 class="section-title" id="includes-title">What's Included</h2>
      <div class="section-line"></div>
    </div>
    <div class="svc-grid">
      {service.includes.map((item) => (
        <div class="svc-item">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
    <ul class="stack" aria-label="Technologies we use">
      {service.stack.map((tech) => <li>{tech}</li>)}
    </ul>
  </section>

  <section class="section" aria-labelledby="proof-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="proof-title">Work That Shows It</h2>
      <div class="section-line"></div>
    </div>
    <div class="proofs">
      {service.proof.map((p) => (
        <article class={p.stats ? 'proof' : 'proof no-stats'}>
          <div>
            <span class="kicker">{p.kicker}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            {p.link && (
              p.link.href.startsWith('http')
                ? <a class="proof-link" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a>
                : <a class="proof-link" href={p.link.href}>{p.link.label}</a>
            )}
          </div>
          {p.stats && (
            <div class="proof-stats">
              {p.stats.map((stat) => (
                <div class="proof-stat">
                  <div class="proof-stat-num">{stat.value}</div>
                  <div class="proof-stat-label">{stat.label}</div>
                </div>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="steps-title">How We Work</h2>
      <div class="section-line"></div>
    </div>
    <div class="steps">
      {SERVICE_STEPS.map((step, i) => (
        <div class="step">
          <span class="kicker">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="faq-title">Common Questions</h2>
      <div class="section-line"></div>
    </div>
    <Faq items={service.faq} />
  </section>

  <section class="section" aria-labelledby="related-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="related-title">Related Services</h2>
      <div class="section-line"></div>
    </div>
    <div class="related">
      {related.map((r) => <a href={serviceUrl(r.slug)}>{r.name}</a>)}
      <a href={SERVICES_PATH}>All services →</a>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-glow"></div>
    <p class="cta-eyebrow">// Let's Build Something</p>
    <h2 class="cta-title">Have a Project <span>in Mind?</span></h2>
    <p class="cta-body">Tell us what you're building and we'll reply within 24 hours.</p>
    <div class="cta-actions">
      <a href="/#contact" class="btn-primary">Start a Conversation</a>
      <a href="mailto:info@riroteglobal.com" class="btn-outline">Email Us</a>
    </div>
  </section>
</main>
</BaseLayout>

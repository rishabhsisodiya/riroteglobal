---
// One page per service, built from src/data/services.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/Crumbs.astro';
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbs, service as serviceNode, webPage } from '../../lib/schema';
import { contactUrl } from '../../data/site';
import { SERVICES, SERVICES_PATH, SERVICE_STEPS, serviceBySlug, serviceUrl, type Service } from '../../data/services';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props as { service: Service };
const path = serviceUrl(service.slug);
const related = service.related.map(serviceBySlug).filter((s): s is Service => Boolean(s));
const talk = contactUrl({ service: service.name });

const seo = {
  title: service.metaTitle,
  path,
  description: service.description,
  ogTitle: `${service.name} | Rirote Global`,
  schema: [
    webPage({ path, name: service.name }),
    serviceNode({ name: service.name, serviceType: service.techName, description: service.summary, path }),
    breadcrumbs(['Home', '/'], ['Services', SERVICES_PATH], [service.name, path]),
  ],
};
---
<BaseLayout seo={seo} nav={{ current: 'services' }}>
<main id="main">
  <section class="page-hero">
    <div class="hero-content">
      <Crumbs items={[['Home', '/'], ['Services', SERVICES_PATH], [service.name]]} />
      <p class="eyebrow">{service.techName}</p>
      <h1 class="page-title">{service.heading[0]} <span>{service.heading[1]}</span></h1>
      <p class="page-sub">{service.intro}</p>
      <div class="hero-actions">
        <a href={talk} class="btn-primary">Talk to Us</a>
        <a href="/projects" class="btn-outline">See Our Work</a>
      </div>
    </div>
  </section>

  <section class="band whoband">
    <div class="wrap" data-reveal>
      <p class="eyebrow">Who does the work</p>
      <p class="whotext">Engineers who worked at multinational companies, building for clients around the world. The people who plan your project also build and run it. <a href="/about">More about us →</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="includes-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="includes-title">What's included</h2></div>
      <div class="incl three">
        {service.includes.map((item) => <div class="inc" data-reveal><h3>{item.title}</h3><p>{item.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="proof-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="proof-title">Work that shows it</h2></div>
      <div class="ascents">
        {service.proof.map((p) => (
          <article class="proof" data-reveal>
            <div>
              <span class="kicker">{p.kicker}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              {p.link && <a class="proof-link" href={p.link.href}>{p.link.label}</a>}
            </div>
            {p.stats && (
              <div class="proof-stats">
                {p.stats.map((stat) => <div><b data-count>{stat.value}</b><span>{stat.label}</span></div>)}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="steps-title">How we work</h2></div>
      <div class="steps">{SERVICE_STEPS.map((step) => <div class="step" data-reveal><h3>{step.title}</h3><p>{step.text}</p></div>)}</div>
    </div>
  </section>

  <section class="band" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="faq-title">Common questions</h2></div>
      <Faq items={service.faq} />
    </div>
  </section>

  <section class="band" aria-labelledby="related-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="related-title">Related services</h2></div>
      <div class="rel">
        {related.map((r) => <a href={serviceUrl(r.slug)}><b>{r.name}</b><span>{r.summary}</span></a>)}
      </div>
      <p class="seeall"><a class="btn-outline" href={SERVICES_PATH}>All services →</a></p>
    </div>
  </section>

  <Cta eyebrow="Let's Talk" title="Have a project in mind?" body="Tell us what you're building and we'll get back to you as soon as we can.">
    <a href={talk} class="btn-primary">Start a Conversation</a>
    <a href="mailto:info@riroteglobal.com" class="btn-outline">Email Us</a>
  </Cta>
</main>
</BaseLayout>

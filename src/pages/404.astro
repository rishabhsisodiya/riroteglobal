---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = { title: 'Page Not Found | Rirote Global', noindex: true };
---
<BaseLayout seo={seo}>
<main id="main">
  <section class="page-hero" style="padding-block:clamp(60px,12vw,140px)">
    <div class="hero-content">
      <p class="eyebrow">Page not found</p>
      <h1 class="page-title">404</h1>
      <p class="page-sub">That page doesn't exist or has moved. Here's where to go next.</p>
      <div class="hero-actions">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/products" class="btn-outline">Our Products</a>
      </div>
    </div>
  </section>
</main>
</BaseLayout>

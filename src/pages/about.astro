---
import BaseLayout from '../layouts/BaseLayout.astro';
import Crumbs from '../components/Crumbs.astro';
import Cta from '../components/Cta.astro';
import { aboutPage, breadcrumbs } from '../lib/schema';
import { COMPANY_STATS, SITE } from '../data/site';
import { ENGAGEMENTS, SERVICES_PATH } from '../data/services';
import { caseUrl } from '../data/cases';

const path = '/about';
const seo = {
  title: 'About Rirote Global | Software & ERPNext Company, Jaipur',
  path,
  description: 'Full-stack, AI and ERP engineering company in Jaipur, India, building software for businesses in India, the US and the Middle East.',
  ogTitle: 'About Rirote Global',
  schema: [aboutPage(path), breadcrumbs(['Home', '/'], ['About', path])],
};

const name = [
  { letters: 'RI', word: 'Rise', text: 'Strategy that moves a business forward. Every build starts from what has to change for the business, not from the tech stack.' },
  { letters: 'RO', word: 'Robust', text: 'Software that keeps working for real users: secure, monitored, and ready for more people over time.' },
  { letters: 'TE', word: 'Tech', text: 'Modern, proven tools, including ERPNext, cloud hosting and AI, used where they help.' },
];

const pillars = [
  {
    kicker: 'Client engineering',
    title: 'Software Built for You',
    text: 'Websites and web apps, AI assistants, ERPNext integration and hosting, planned, built and looked after by one team.',
    links: [{ href: SERVICES_PATH, label: 'Our services' }, { href: '/projects', label: 'Selected projects' }],
  },
  {
    kicker: 'Our products',
    title: 'Software We Ship',
    text: 'Products we build and run ourselves, starting with ERPTick: the ERPNext-connected service desk for equipment makers.',
    links: [{ href: '/products/erptick', label: 'Explore ERPTick' }],
  },
  {
    kicker: 'Open source',
    title: 'Built in the Open',
    text: 'Free tools and learning material for engineers: the CrackThePrep interview hub, and stop-guessing, agent skills that stop AI coding tools from inventing decisions.',
    links: [{ href: '/#opensource', label: 'See our open source' }],
  },
];

const principles = [
  { title: 'One Team Throughout', text: 'The same people plan, build, launch and support your software, so nothing gets lost in a hand-over.' },
  { title: 'Decisions Before Code', text: 'What the software must do is written down and agreed before building, then checked against what was asked for.' },
  { title: 'Ready for Real Use', text: 'Security, monitoring and speed are part of the build from the start.' },
  { title: 'Confidential by Default', text: 'We work under NDA when asked, and we never name a client without permission.' },
];

// What experience adds, each tied to a real (anonymised) case study.
const experience = [
  { title: 'Scaling', text: 'Knowing what breaks at ten times the users, before it does.', slug: 'high-traffic-ecommerce-platform', proof: 'A high-traffic store: a plan to move from one big application to microservices' },
  { title: 'System design', text: 'Data models, boundaries and integrations that still make sense in two years.', slug: 'foundry-operations-erp', proof: 'A foundry ERP joined to ERPNext through a safe, retry-friendly boundary' },
  { title: 'Performance', text: 'Slow queries, caching and parallel work, found and fixed.', slug: 'unified-erp-service-platform', proof: 'Dashboards from 5s+ down to under 500ms' },
  { title: 'Security', text: 'Logins, permissions and keys done properly from day one, not patched later.', slug: 'nimnim', proof: 'The API of a live platform, secured while customers kept ordering' },
  { title: 'Cost', text: 'Hosting sized to what you really need, not to what was easiest to set up.', slug: 'nimnim', proof: 'A 50% lower AWS bill' },
  { title: 'Ownership', text: 'People who have led teams and owned features all the way to production support.', slug: 'multi-service-delivery-platform', proof: 'A platform for food, parcels and rides, led from API design to support' },
];
---
<BaseLayout seo={seo} nav={{ current: 'about' }}>
<main id="main">
  <section class="page-hero">
    <div class="hero-content">
      <Crumbs items={[['Home', '/'], ['About']]} />
      <p class="eyebrow">About Rirote Global</p>
      <h1 class="page-title">Engineers Who Have <span>Done This at Scale.</span></h1>
      <p class="page-sub">Rirote Global is a small software company in Jaipur, India. We build websites, business software, AI features and ERPNext systems for companies in India, the United States and the Middle East, and we build software products of our own.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Talk to Us</a>
        <a href="/projects" class="btn-outline">See Our Work</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap about">
      <div data-reveal>
        <h2 class="h2s">Not an agency that hands your project to AI.</h2>
        <p>Our engineers have worked at multinational companies and built applications for large clients around the world. We have solved the problems that only appear when software meets real users, real data and real deadlines.</p>
        <p>We understand what you need, plan the solution from that experience, and then deliver it. The people who plan the work are the people who build and run it.</p>
      </div>
      <div class="stats">
        <div><b data-count>{COMPANY_STATS.projects.value}</b><span>{COMPANY_STATS.projects.label}</span></div>
        <div><b data-count>{COMPANY_STATS.industries.value}</b><span>{COMPANY_STATS.industries.label}</span></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="sec-h" data-reveal>
        <h2 class="section-title">Anyone can build an app with AI now. Few can make it last.</h2>
        <p class="section-sub">AI has made the first version quick and cheap, and we use it too. But a working demo and a system your business can depend on are different things. The gap between them is experience.</p>
      </div>
      <div class="incl three">
        {experience.map((x) => (
          <a class="inc" href={caseUrl(x.slug)} data-reveal><h3>{x.title}</h3><p>{x.text}</p><span class="proof2">{x.proof} →</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="band dark">
    <div class="wrap">
      <h2 class="h-lg" data-reveal>How we use AI</h2>
      <p class="lead" style="max-width:62ch" data-reveal>AI helps us write code faster. It does not decide what to build, how it should scale or what could go wrong. Engineers who answer for the result make those decisions. To keep AI honest we released stop-guessing, open-source guardrails for AI coding agents.</p>
      <div class="cta-row"><a class="btn-outline" href="/products/stop-guessing">About stop-guessing</a><a class="btn-outline" href="/services/ai-integration">AI in your product</a></div>
    </div>
  </section>

  <section class="band" aria-labelledby="name-title">
    <div class="wrap">
      <div class="sec-h" data-reveal>
        <h2 class="section-title" id="name-title">The Name Is the Promise</h2>
        <p class="section-sub">Rirote comes from three words we hold every project to.</p>
      </div>
      <div class="roles">
        {name.map((n) => <div class="role" data-reveal><span class="kicker" aria-hidden="true">{n.letters}</span><h3>{n.word}</h3><p>{n.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="do-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="do-title">What We Do</h2></div>
      <div class="roles">
        {pillars.map((p) => (
          <article class="role" data-reveal>
            <span class="kicker">{p.kicker}</span><h3>{p.title}</h3><p>{p.text}</p>
            <p style="margin-top:10px">{p.links.map((l) => <a href={l.href} class="more-link" style="margin-right:16px">{l.label} →</a>)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="how-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="how-title">How We Work</h2></div>
      <div class="steps">{principles.map((p) => <div class="step" data-reveal><h3>{p.title}</h3><p>{p.text}</p></div>)}</div>
    </div>
  </section>

  <section class="band" aria-labelledby="ways-title">
    <div class="wrap">
      <div class="sec-h" data-reveal><h2 class="section-title" id="ways-title">Ways to Work With Us</h2></div>
      <div class="roles">
        {ENGAGEMENTS.map((e) => (
          <article class="role" data-reveal>
            <h3>{e.title}</h3><p>{e.text}</p>
            {e.href && <p style="margin-top:8px"><a href={e.href} class="more-link">Learn more →</a></p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="team-title">
    <div class="wrap">
      <div class="sec-h" data-reveal>
        <h2 class="section-title" id="team-title">A Small Team, Close to the Work</h2>
        <p class="section-sub">We are a team of up to ten people, extended with vetted engineers when a project needs more hands. Staying small means you work directly with the people designing and building your software.</p>
      </div>
      <p class="nda-note">{SITE.legal.name} · {SITE.legal.city}, {SITE.legal.state}, {SITE.legal.country}</p>
    </div>
  </section>

  <Cta eyebrow="Let's Talk" title="Have Something to Build?" body="Tell us what you're working on. We reply within 24 hours.">
    <a href="/contact" class="btn-primary">Start a Conversation</a>
    <a href={`mailto:${SITE.email}`} class="btn-outline">Email Us</a>
  </Cta>
</main>
</BaseLayout>

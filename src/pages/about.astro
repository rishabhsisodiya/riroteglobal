---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutPage, breadcrumbs } from '../lib/schema';
import { COMPANY_STATS, SITE } from '../data/site';
import { ENGAGEMENTS, SERVICES_PATH } from '../data/services';

const path = '/about';
const seo = {
  title: 'About Rirote Global | Software & ERPNext Company, Jaipur',
  path,
  description: 'Full-stack, AI and ERP engineering company in Jaipur, India, building software for businesses in India, the US and the Middle East.',
  ogTitle: 'About Rirote Global',
  schema: [aboutPage(path), breadcrumbs(['Home', '/'], ['About', path])],
};

const name = [
  { letters: 'RI', word: 'Rise', text: 'Strategy that moves a business forward. Every build starts from what has to change for the business, not from the tech stack.' },
  { letters: 'RO', word: 'Robust', text: 'Software that keeps working for real users: secure, monitored, and ready for more people over time.' },
  { letters: 'TE', word: 'Tech', text: 'Modern, proven tools, including ERPNext, cloud hosting and AI, used where they help.' },
];

const pillars = [
  {
    kicker: 'Client engineering',
    title: 'Software Built for You',
    text: 'Websites and web apps, AI assistants, ERPNext integration and hosting, planned, built and looked after by one team.',
    links: [{ href: SERVICES_PATH, label: 'Our services' }, { href: '/projects', label: 'Selected projects' }],
  },
  {
    kicker: 'Our products',
    title: 'Software We Ship',
    text: 'Products we build and run ourselves, starting with ERPTick: the ERPNext-connected service desk for equipment makers.',
    links: [{ href: '/products/erptick', label: 'Explore ERPTick' }],
  },
  {
    kicker: 'Open source',
    title: 'Built in the Open',
    text: 'Free tools and learning material for engineers: the CrackThePrep interview hub, and stop-guessing, agent skills that stop AI coding tools from inventing decisions.',
    links: [{ href: '/#opensource', label: 'See our open source' }],
  },
];

const principles = [
  { title: 'One Team Throughout', text: 'The same people plan, build, launch and support your software, so nothing gets lost in a hand-over.' },
  { title: 'Decisions Before Code', text: 'What the software must do is written down and agreed before building, then checked against what was asked for.' },
  { title: 'Ready for Real Use', text: 'Security, monitoring and speed are part of the build from the start.' },
  { title: 'Confidential by Default', text: 'We work under NDA when asked, and we never name a client without permission.' },
];

---
<BaseLayout seo={seo} nav={{ current: 'about' }}>
<Fragment slot="head">
<style is:inline>
  .name-grid, .card-grid { display: grid; gap: 1.5rem; margin-top: 2.5rem; }
  .name-grid { grid-template-columns: repeat(3, 1fr); }
  .card-grid { grid-template-columns: repeat(3, 1fr); }
  .card-grid.four { grid-template-columns: repeat(4, 1fr); }

  .name-item { border-top: 1px solid var(--line-strong); padding-top: 1.5rem; }
  .name-letters {
    font-family: 'Bebas Neue', sans-serif; font-size: 4rem; line-height: 0.9; letter-spacing: 0.06em;
    color: var(--white);
  }
  .name-item:nth-child(2) .name-letters { color: var(--cyan); }
  .name-word {
    font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: var(--accent-text); margin: 0.6rem 0 0.9rem; font-weight: 600; }
  .name-item p, .about-card p { color: var(--text-soft); line-height: 1.75; }

  .about-card {
    display: flex; flex-direction: column; gap: 0.9rem;
    background: var(--navy-card); border: 1px solid var(--line); border-radius: var(--radius-card);
    padding: 1.8rem 1.8rem 2rem;
    transition: border-color 0.3s;
  }
  .about-card:hover { border-color: var(--line-strong); }
  .about-card h3 {
    font-family: 'DM Sans', sans-serif; font-weight: 700;
    font-size: 1.3rem; letter-spacing: -0.01em; line-height: 1.05;
  }
  .about-card .card-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; margin-top: auto; padding-top: 0.4rem; }
  .about-card .card-links a, .about-card .card-more {
    font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 700; color: var(--accent-text); text-decoration: none;
  }
  .about-card .card-links a:hover, .about-card .card-more:hover { color: var(--white); }
  .card-index {
    font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: var(--muted); font-weight: 600; }

  .team-text { max-width: 720px; color: var(--text-soft); font-size: 1.05rem; line-height: 1.8; margin: 1rem 0 2.5rem; }
  .metrics.two { grid-template-columns: repeat(2, 1fr); }
  .company-line {
    margin-top: 1.6rem; position: relative;
    font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: var(--muted); font-weight: 500; }

  @media (max-width: 1100px) {
    .card-grid.four { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .name-grid, .card-grid, .card-grid.four { grid-template-columns: 1fr; }
    .name-letters { font-size: 3.2rem; }
  }

  /* Phones: body copy at least 16px, small caps labels at least 12px, tap targets at least 44px. */
  @media (max-width: 900px) {
    .company-line, .name-word, .card-index, .about-card .card-links a, .about-card .card-more { font-size: 0.75rem; }
    .about-card .card-links a, .about-card .card-more { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
</Fragment>

<main id="main">
  <section class="page-hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <p class="eyebrow fade-up d1">About Rirote Global</p>
      <h1 class="page-title fade-up d2">A Small Software Company<br><span>in Jaipur, India.</span></h1>
      <p class="page-sub fade-up d3">Rirote Global builds websites, business software, AI features and ERPNext systems for companies in India, the United States and the Middle East. We also build software products of our own.</p>
      <div class="hero-actions fade-up d4">
        <a href="/#contact" class="btn-primary">Talk to Us</a>
        <a href="/projects" class="btn-outline">See Our Work</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="name-title">
    <div class="section-header">
      <h2 class="section-title" id="name-title">The Name Is the Promise</h2>
      <div class="section-line"></div>
    </div>
    <p class="section-sub">Rirote comes from three words we hold every project to.</p>
    <div class="name-grid">
      {name.map((n) => (
        <div class="name-item">
          <div class="name-letters" aria-hidden="true">{n.letters}</div>
          <h3 class="name-word">{n.word}</h3>
          <p>{n.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="do-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="do-title">What We Do</h2>
      <div class="section-line"></div>
    </div>
    <div class="card-grid">
      {pillars.map((p) => (
        <article class="about-card">
          <span class="kicker">{p.kicker}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <div class="card-links">
            {p.links.map((l) => <a href={l.href}>{l.label} →</a>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="how-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="how-title">How We Work</h2>
      <div class="section-line"></div>
    </div>
    <div class="card-grid four">
      {principles.map((p, i) => (
        <article class="about-card">
          <span class="card-index">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="ways-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="ways-title">Ways to Work With Us</h2>
      <div class="section-line"></div>
    </div>
    <div class="card-grid">
      {ENGAGEMENTS.map((e) => (
        <article class="about-card">
          <h3>{e.title}</h3>
          <p>{e.text}</p>
          {e.href && <a class="card-more" href={e.href}>Learn more →</a>}
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="team-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="team-title">A Small Team, Close to the Work</h2>
      <div class="section-line"></div>
    </div>
    <p class="team-text">We are a team of up to ten people, extended with vetted engineers when a project needs more hands. Staying small means you work directly with the people designing and building your software.</p>
  </section>

  <div class="metrics two">
    <div class="metric-item">
      <div class="metric-value">{COMPANY_STATS.projects.value}</div>
      <div class="metric-label">{COMPANY_STATS.projects.label}</div>
    </div>
    <div class="metric-item">
      <div class="metric-value">{COMPANY_STATS.industries.value}</div>
      <div class="metric-label">{COMPANY_STATS.industries.label}</div>
    </div>
  </div>

  <section class="cta-section">
    <div class="cta-glow"></div>
    <p class="cta-eyebrow">Let's Talk</p>
    <h2 class="cta-title">Have Something to Build?</h2>
    <p class="cta-body">Tell us what you're working on. We reply within 24 hours.</p>
    <div class="cta-actions">
      <a href="/#contact" class="btn-primary">Start a Conversation</a>
      <a href={`mailto:${SITE.email}`} class="btn-outline">Email Us</a>
    </div>
    <p class="company-line">{SITE.legal.name} · {SITE.legal.city}, {SITE.legal.state}, {SITE.legal.country}</p>
  </section>
</main>
</BaseLayout>

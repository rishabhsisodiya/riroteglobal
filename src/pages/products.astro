---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbs } from '../lib/schema';
import { ERPTICK_SHARE_IMAGE } from '../data/erptick';

const seo = {
  title: 'Products — Rirote Global',
  path: '/products',
  description: 'Software products built by Rirote Global — starting with ERPTick, the ERPNext-connected service desk for equipment makers.',
  image: ERPTICK_SHARE_IMAGE,
  schema: [breadcrumbs(['Home', '/'], ['Products', '/products'])],
};
---
<BaseLayout seo={seo} nav={{ current: 'products' }}>
<Fragment slot="head">
<style is:inline>
  .products-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  /* ── PRODUCT CARD ── */
  .product-card {
    --accent: #10b981; --accent-text: #34d399;
    --accent-soft: rgba(16,185,129,0.1); --accent-line: rgba(52,211,153,0.35);
    position: relative;
    display: grid; grid-template-rows: auto 1fr;
    background: var(--navy-card);
    border: 1px solid var(--line);
    border-radius: 8px; overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .product-card:hover {
    border-color: var(--accent-line);
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .product-shot {
    aspect-ratio: 16 / 10; width: 100%; object-fit: cover; object-position: top left;
    border-bottom: 1px solid var(--line);
  }
  .product-body { padding: 1.8rem 2rem 2rem; display: flex; flex-direction: column; gap: 1.1rem; }
  .product-meta { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .status-badge {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--accent-text);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    padding: 0.25rem 0.7rem; border-radius: 3px;
  }
  .status-badge::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-text);
  }
  .product-name {
    font-family: 'Bebas Neue', sans-serif; font-weight: 400;
    font-size: 2.6rem; letter-spacing: 0.04em; line-height: 1;
  }
  .product-name a { text-decoration: none; }
  /* whole card clickable via the title link */
  .product-name a::after { content: ''; position: absolute; inset: 0; }
  .product-pitch { color: var(--text-soft); font-size: 1rem; line-height: 1.7; max-width: 60ch; }
  .product-points { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1.5rem; }
  .product-points li {
    font-size: 0.9rem; color: rgba(240,244,255,0.82);
    padding-left: 1.2rem; position: relative; line-height: 1.5;
  }
  .product-points li::before {
    content: ''; position: absolute; left: 0; top: 0.55rem;
    width: 6px; height: 6px; border-radius: 50%; background: var(--accent-text);
  }
  .product-go {
    margin-top: auto; padding-top: 0.4rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-text); font-weight: 700;
  }

  /* ── COMING SOON CARD ── */
  .soon-card {
    border: 1px dashed var(--line-strong);
    border-radius: 8px;
    padding: 2rem;
    display: flex; flex-direction: column; justify-content: center; gap: 1rem;
    background: linear-gradient(180deg, rgba(0,180,216,0.04), transparent);
  }
  .soon-card .product-name { font-size: 2rem; }
  .soon-card p { color: var(--text-soft); font-size: 0.95rem; line-height: 1.7; }
  .soon-card .btn-outline { align-self: flex-start; }

  @media (max-width: 900px) {
    .products-grid { grid-template-columns: 1fr; }
    .product-body { padding: 1.5rem 1.25rem 1.75rem; }
    .product-points { grid-template-columns: 1fr; }
  }
</style>
</Fragment>

<main id="main">
  <section class="page-hero">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>
    <div class="hero-content">
      <p class="eyebrow fade-up d1">// Products</p>
      <h1 class="page-title fade-up d2">Software We Build<br><span>and Ship Ourselves.</span></h1>
      <p class="page-sub fade-up d3">Focused products for operations-heavy businesses — built on the same engineering we deliver for clients, and connected to the systems you already run.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="all-products">
    <div class="section-header">
      <h2 class="section-title" id="all-products">All Products</h2>
      <div class="section-line"></div>
    </div>

    <div class="products-grid">
      <article class="product-card">
        <img class="product-shot" src="/assets/products/erptick/posters/01-tickets.jpg" width="1280" height="800" alt="ERPTick ticket screen showing stage progress, SLA status and AMC coverage for a crusher breakdown.">
        <div class="product-body">
          <div class="product-meta">
            <span class="status-badge">Early access</span>
            <span class="kicker">Field Service · ERPNext</span>
          </div>
          <h3 class="product-name"><a href="/products/erptick">ERPTick Service Desk</a></h3>
          <p class="product-pitch">The service desk for equipment makers, connected to ERPNext. Tickets, field visits, AMC contracts, quotations and SLAs in one place — with customers, machines and stock read straight from your ERP.</p>
          <ul class="product-points">
            <li>Tickets with SLA clocks &amp; routing</li>
            <li>Field visits with customer sign-off</li>
            <li>AMC contracts &amp; quotations</li>
            <li>Customer portal, email &amp; WhatsApp</li>
          </ul>
          <span class="product-go" aria-hidden="true">Explore ERPTick →</span>
        </div>
      </article>

      <aside class="soon-card" aria-labelledby="soon-title">
        <span class="kicker">In the works</span>
        <h3 class="product-name" id="soon-title">More Coming</h3>
        <p>We're building more products for teams that run on ERP and field operations. Want to hear when the next one is ready?</p>
        <a class="btn-outline" href="mailto:info@riroteglobal.com?subject=Notify%20me%20about%20new%20Rirote%20products">Get notified</a>
      </aside>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-glow"></div>
    <p class="cta-eyebrow">// Need Something Custom?</p>
    <h2 class="cta-title">Built for You, Not Off the Shelf</h2>
    <p class="cta-body">If a product doesn't fit your workflow exactly, we build full-stack and AI solutions around how your business actually runs.</p>
    <div class="cta-actions">
      <a href="/#contact" class="btn-primary">Start a Conversation</a>
      <a href="/#services" class="btn-outline">View Services</a>
    </div>
  </section>
</main>
</BaseLayout>

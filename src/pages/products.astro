---
import BaseLayout from '../layouts/BaseLayout.astro';
import Crumbs from '../components/Crumbs.astro';
import ProductRow from '../components/ProductRow.astro';
import { breadcrumbs, webPage } from '../lib/schema';
import { ERPTICK_SHARE_IMAGE } from '../data/erptick';
import { PROBLEMS } from '../data/cases';
import { PRODUCTS, type Product } from '../data/products';

const seo = {
  title: 'Software Products for Busy Operations | Rirote Global',
  path: '/products',
  description: 'ERPTick and other software products we build and run for businesses with busy operations, connected to the systems they already use.',
  image: ERPTICK_SHARE_IMAGE,
  schema: [
    webPage({ path: '/products', name: 'Products', type: 'CollectionPage' }),
    breadcrumbs(['Home', '/'], ['Products', '/products']),
  ],
};

const statuses = [...new Set(PRODUCTS.flatMap((p) => p.status ?? []))];
const groups: Array<[Product['group'], string | null]> = [['Products', null], ['Open source', 'Free to use, and public.']];

const approach = [
  ['Connected', 'Your ERP stays the source', 'Customers, machines, items and stock are read from ERPNext. Nothing is written back until you switch it on, and invoices are always created as drafts.'],
  ['Separate', 'One company, one install', "Every customer gets their own install and database, so your data is never mixed with anyone else's. Host it with us or on a server you control."],
  ['Try First', 'Start on demo data', 'ERPTick runs on a fictional demo company until you connect your ERP, so your team can try every flow before anything touches live data.'],
];
---
<BaseLayout seo={seo} nav={{ current: 'products' }}>
<main id="main">
  <section class="page-hero">
    <div class="hero-content">
      <Crumbs items={[['Home', '/'], ['Products']]} />
      <p class="eyebrow">Products</p>
      <h1 class="page-title">Software we build <span>and ship ourselves.</span></h1>
      <p class="page-sub">Software for businesses with busy operations, built by the same team that builds for clients and connected to the systems you already use.</p>
    </div>
  </section>

  <section class="wrap" data-filters aria-labelledby="all-products" style="padding-bottom:clamp(40px,6vw,80px)">
    <h2 class="section-title" id="all-products" style="font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:18px">All products</h2>
    <div class="filters" role="group" aria-label="Filter by status">
      <span class="fl">Status</span>
      <button class="fchip" type="button" data-key="status" data-val="" aria-pressed="true">All</button>
      {statuses.map((s) => <button class="fchip" type="button" data-key="status" data-val={s.replace(/ /g, '-')} aria-pressed="false">{s}</button>)}
      <label class="fl" for="pneed" style="margin-left:8px">Problem</label>
      <select class="fsel" id="pneed" data-key="tags">
        <option value="">Any problem</option>
        {PROBLEMS.map((p) => <option value={p.id}>{p.label}</option>)}
      </select>
    </div>
    <p class="fcount" data-filter-count data-noun="products" role="status"></p>

    {groups.map(([group, intro]) => (
      <div data-group>
        {intro && <><h3 class="group-h">{group}</h3><p class="group-d">{intro}</p></>}
        <div class="prows">
          {PRODUCTS.filter((p) => p.group === group).map((p) => (
            <ProductRow product={p} showTags shotAlt="ERPTick ticket screen showing stage progress, SLA status and AMC coverage for a crusher breakdown." />
          ))}
        </div>
        {group === 'Products' && (
            <aside class="soon" aria-labelledby="soon-title">
              <span class="kicker">In the works</span>
              <h3 id="soon-title">More coming</h3>
              <p>We're building more products for teams that run on ERP and field operations. Want to hear when the next one is ready?</p>
              <a class="btn-outline" href="mailto:info@riroteglobal.com?subject=Notify%20me%20about%20new%20Rirote%20products">Get notified</a>
            </aside>
          )}
      </div>
    ))}
    <p class="note2" data-filter-empty hidden>No product matches that. Try another filter, or <a href="/contact">tell us what you need</a>. A custom build is often the answer.</p>
  </section>

  <section class="band" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="sec-h" data-reveal>
        <h2 class="section-title" id="approach-title">How our products work</h2>
        <p class="section-sub">Our products come from the same engineering we do for clients: ticketing, dashboards and integrations built on ERPNext for manufacturers and service businesses. We build them for operations-heavy teams that already run their business on an ERP and need software that fits around it, not another system to keep in sync by hand. Here is how that works in ERPTick.</p>
      </div>
      <div class="approach">
        {approach.map(([k, t, b]) => <div class="approach-item" data-reveal><span class="kicker">{k}</span><h3>{t}</h3><p>{b}</p></div>)}
      </div>
    </div>
  </section>
</main>
</BaseLayout>

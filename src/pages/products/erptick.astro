---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import { breadcrumbs, faqPage, webPage } from '../../lib/schema';
import { ERPTICK_FAQ, ERPTICK_PATH, ERPTICK_SHARE_IMAGE, erptickSoftwareApp, erptickVideoObjects } from '../../data/erptick';

const year = new Date().getFullYear();
const seo = {
  title: 'ERPTick: Service Desk for Equipment Makers on ERPNext',
  path: ERPTICK_PATH,
  description: 'Field service desk for equipment makers on ERPNext: tickets with SLAs, field visits, AMC contracts, quotations and a customer portal, synced with your ERP.',
  ogTitle: 'ERPTick: Service Desk for Equipment Makers',
  ogDescription: 'Breakdown calls, engineer visits, AMC contracts and quotations for your service team, connected to ERPNext. Now in early access.',
  image: ERPTICK_SHARE_IMAGE,
  schema: [
    webPage({ path: ERPTICK_PATH, name: 'ERPTick Service Desk' }),
    erptickSoftwareApp(),
    breadcrumbs(['Home', '/'], ['Products', '/products'], ['ERPTick Service Desk', ERPTICK_PATH]),
    faqPage(ERPTICK_FAQ),
    ...erptickVideoObjects(),
  ],
};
---
<BaseLayout seo={seo} nav={{ current: 'products', cta: { href: '#early-access', label: 'Join Early Access' } }} rail={{ stops: [['overview', 'Overview'], ['tour', 'Tour'], ['faq', 'FAQ'], ['early-access', 'Access']], summitLabel: 'Ask for access' }}>
<main id="main">

  <!-- ══ HERO ══ -->
  <section class="page-hero sb-hero" id="overview">
        <div class="hero-content">
      <p class="eyebrow fade-up d1"><a href="/products" style="text-decoration:none;">Products</a> / ERPTick Service Desk</p>
      <span class="hero-status fade-up d1">Now in early access</span>
      <h1 class="page-title fade-up d2">The Service Desk<br>for Equipment Makers.<br><span>Connected to ERPNext.</span></h1>
      <p class="page-sub fade-up d3">Tickets, field visits, AMC contracts and quotations for your service team, with customers, machines, spares and stock taken straight from ERPNext. No double entry, no spreadsheets on the side.</p>
      <div class="hero-actions fade-up d4">
        <a href="#early-access" class="btn-primary">Join Early Access</a>
        <a href="#promo" class="btn-outline" id="playPromo">Watch the 90-sec overview</a>
      </div>
      <p class="hero-note fade-up d4">Runs on a demo company until you connect your ERP</p>
    </div>
    <div class="app-frame fade-up d4">
      <video id="promo" controls preload="none" playsinline width="1920" height="1080"
             poster="/assets/products/erptick/posters/promo.webp"
             src="/assets/products/erptick/promo.mp4"
             aria-label="ERPTick Service Desk overview video, 90 seconds, with narration and captions"></video>
    </div>
  </section>

  <!-- ══ WHO IT'S FOR ══ -->
  <section class="section" aria-labelledby="who">
    <div class="section-header">
      <h2 class="section-title" id="who">One System for Everyone in Service</h2>
      <div class="section-line"></div>
    </div>
    <p class="section-sub">Built for manufacturers who sell, install and service machines, and already run their business on ERPNext.</p>
    <div class="roles">
      <div class="role">
        <span class="kicker">Service head</span>
        <h3>See Every Commitment</h3>
        <p>Late calls, open AMCs, pending quotations and results by region, without asking anyone for an update.</p>
      </div>
      <div class="role">
        <span class="kicker">Support desk</span>
        <h3>Log &amp; Route in Seconds</h3>
        <p>Pick the customer and machine; coverage, priority and the right region are worked out for you.</p>
      </div>
      <div class="role">
        <span class="kicker">Field engineers</span>
        <h3>Close Visits on Site</h3>
        <p>A phone-friendly visit form with spares used, photos and the customer's signature.</p>
      </div>
      <div class="role">
        <span class="kicker">Your customers</span>
        <h3>Self-Serve Portal</h3>
        <p>Customers raise tickets, follow progress, approve quotations and rate the service from their own login.</p>
      </div>
    </div>
  </section>

  <!-- ══ MODULE TOUR ══ -->
  <div class="alt-bg">
  <section class="section" id="tour" aria-labelledby="tour-title">
    <div class="section-header">
      <h2 class="section-title" id="tour-title">See It Work</h2>
      <div class="section-line"></div>
    </div>
    <p class="section-sub">Want the detail? Ten short walkthroughs of the real product on demo data. Pick a module. Each video has narration and captions.</p>

    <div class="tour">
      <div class="tour-tabs" role="tablist" aria-label="ERPTick Service Desk modules" aria-orientation="vertical">
        <button class="tour-tab" role="tab" id="tab-tickets" aria-controls="panel-tickets" aria-selected="true"><span>Tickets &amp; SLAs</span><span class="dur">0:56</span></button>
        <button class="tour-tab" role="tab" id="tab-visits" aria-controls="panel-visits" aria-selected="false" tabindex="-1"><span>Field Visits</span><span class="dur">0:54</span></button>
        <button class="tour-tab" role="tab" id="tab-quotations" aria-controls="panel-quotations" aria-selected="false" tabindex="-1"><span>Quotations</span><span class="dur">0:44</span></button>
        <button class="tour-tab" role="tab" id="tab-amc" aria-controls="panel-amc" aria-selected="false" tabindex="-1"><span>AMC Contracts</span><span class="dur">0:45</span></button>
        <button class="tour-tab" role="tab" id="tab-customers" aria-controls="panel-customers" aria-selected="false" tabindex="-1"><span>Customers &amp; Machines</span><span class="dur">0:46</span></button>
        <button class="tour-tab" role="tab" id="tab-dispatch" aria-controls="panel-dispatch" aria-selected="false" tabindex="-1"><span>Dispatch &amp; Service Rules</span><span class="dur">0:44</span></button>
        <button class="tour-tab" role="tab" id="tab-portal" aria-controls="panel-portal" aria-selected="false" tabindex="-1"><span>Customer Portal &amp; Updates</span><span class="dur">0:40</span></button>
        <button class="tour-tab" role="tab" id="tab-reports" aria-controls="panel-reports" aria-selected="false" tabindex="-1"><span>Reports &amp; KPIs</span><span class="dur">0:36</span></button>
        <button class="tour-tab" role="tab" id="tab-erp" aria-controls="panel-erp" aria-selected="false" tabindex="-1"><span>ERPNext Connection</span><span class="dur">0:36</span></button>
        <button class="tour-tab" role="tab" id="tab-admin" aria-controls="panel-admin" aria-selected="false" tabindex="-1"><span>Admin &amp; Security</span><span class="dur">0:48</span></button>
      </div>

      <div>
        <div class="tour-panel" role="tabpanel" id="panel-tickets" aria-labelledby="tab-tickets">
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 poster="/assets/products/erptick/posters/01-tickets.webp"
                 src="/assets/products/erptick/01-tickets.mp4"
                 aria-label="Video walkthrough with narration and captions: tickets and SLA clocks"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">Tickets &amp; SLAs</span>
              <h3>Every Breakdown, Tracked to Closure</h3>
              <p>Log a ticket against the exact machine and ERPTick knows whether it's under AMC, under warranty or chargeable. Response and resolution clocks run on your business calendar and warn the team before a deadline is missed, not after.</p>
            </div>
            <ul class="ticks">
              <li>Clear stages from New to Closed, with hold, send-back and reopen</li>
              <li>Coverage detected from the machine: AMC, warranty or chargeable</li>
              <li>SLA targets by coverage and priority, with at-risk alerts</li>
              <li>Duplicate check when a machine already has an open ticket</li>
              <li>Engineers suggested by duty status, skill, region and workload</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-visits" aria-labelledby="tab-visits" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/02-visits.webp"
                 src="/assets/products/erptick/02-visits.mp4"
                 aria-label="Video walkthrough with narration and captions: field visits"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">Field Visits</span>
              <h3>The Whole Job, Recorded on Site</h3>
              <p>Engineers accept the job, mark when they reach the site and log the visit from a phone or laptop: what was done, the spares fitted, photos and the customer's signature.</p>
            </div>
            <ul class="ticks">
              <li>Accept, reached site and resolved, each time-stamped</li>
              <li>Spares picked from your ERP item list</li>
              <li>Up to ten photos per visit</li>
              <li>Customer signature, or a recorded refusal</li>
              <li>A checklist before the visit is submitted</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-quotations" aria-labelledby="tab-quotations" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/03-quotations.webp"
                 src="/assets/products/erptick/03-quotations.mp4"
                 aria-label="Video walkthrough with narration and captions: quotations and purchase orders"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">Quotations</span>
              <h3>Quote Chargeable Work Before It Starts</h3>
              <p>When a machine is out of warranty and AMC, the ticket asks for a quotation. Build it from your ERP items, send it, and record the customer's purchase order against it.</p>
            </div>
            <ul class="ticks">
              <li>Lines from your ERP items, with discount and GST worked out live</li>
              <li>Sending locks the quote and starts its validity</li>
              <li>Revisions are kept; expired quotes are marked for you</li>
              <li>Optional PO gate: chargeable work waits for the PO</li>
              <li>Print-ready quotation with your company details</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-amc" aria-labelledby="tab-amc" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/04-amc.webp"
                 src="/assets/products/erptick/04-amc.mp4"
                 aria-label="Video walkthrough with narration and captions: AMC contracts"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">AMC Contracts</span>
              <h3>Contracts That Plan Their Own Visits</h3>
              <p>Set up an annual maintenance contract once: cover period, value, the machines it covers and the planned preventive visits. ERPTick raises the visit tickets ahead of time and reminds you before the contract ends.</p>
            </div>
            <ul class="ticks">
              <li>Named machines, cover period and contract value</li>
              <li>Planned preventive visits become tickets when due</li>
              <li>Renewal reminders at 60, 30 and 7 days</li>
              <li>Covered machines pick up AMC terms and faster SLAs</li>
              <li>See what ends within 60 days, machine by machine</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-customers" aria-labelledby="tab-customers" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/05-customers.webp"
                 src="/assets/products/erptick/05-customers.mp4"
                 aria-label="Video walkthrough with narration and captions: customers, machines and spares"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">Customers &amp; Machines</span>
              <h3>Know the Machine Before You Answer</h3>
              <p>Customers, sites, contacts, machines by serial number, spares, prices and stock are read from your ERP. Each machine shows its cover, so the desk knows who pays before logging the call.</p>
            </div>
            <ul class="ticks">
              <li>Customers, sites and contacts from your ERP</li>
              <li>Machines by serial number with warranty and AMC dates</li>
              <li>Coverage filters: under AMC, in warranty, chargeable</li>
              <li>Spares with stock by warehouse and both price lists</li>
              <li>Read-only here: your ERP stays the master</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-dispatch" aria-labelledby="tab-dispatch" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/06-dispatch.webp"
                 src="/assets/products/erptick/06-dispatch.mp4"
                 aria-label="Video walkthrough with narration and captions: dispatch and service rules"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">Dispatch &amp; Service Rules</span>
              <h3>Your Rules, Without a Developer</h3>
              <p>Decide how tickets are routed, timed and billed from the settings screens: regions by pincode, skill tags, SLA targets, business calendars and service charges.</p>
            </div>
            <ul class="ticks">
              <li>Engineer availability: on duty, on visit, on leave</li>
              <li>Regions by pincode, each with an area manager</li>
              <li>Skill tags that match machine models to engineers</li>
              <li>SLA targets for every cover and priority</li>
              <li>Auto-assign and three escalation levels, each with a switch</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-portal" aria-labelledby="tab-portal" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/07-portal.webp"
                 src="/assets/products/erptick/07-portal.mp4"
                 aria-label="Video walkthrough with narration and captions: customer portal and updates"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">Customer Portal &amp; Updates</span>
              <h3>Customers Help Themselves</h3>
              <p>Customers sign in with an emailed link, raise tickets, follow progress and approve quotations with their PO number. After closure they rate the job, and updates go out by email or WhatsApp.</p>
            </div>
            <ul class="ticks">
              <li>Sign-in by emailed link, no password</li>
              <li>Raise tickets and follow live status</li>
              <li>Approve or reject quotations online</li>
              <li>Feedback rating once a ticket is closed</li>
              <li>Email and WhatsApp updates in your own wording</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-reports" aria-labelledby="tab-reports" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/08-reports.webp"
                 src="/assets/products/erptick/08-reports.mp4"
                 aria-label="Video walkthrough with narration and captions: reports and KPIs"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">Reports &amp; KPIs</span>
              <h3>Numbers You Can Act On</h3>
              <p>Run service reports on demand, compare every region with its targets in the KPI matrix, and schedule any report to arrive by email as a CSV.</p>
            </div>
            <ul class="ticks">
              <li>Ticket ageing, SLA compliance, engineer performance, quotations and CSAT</li>
              <li>Filter by date, region and priority, then preview or download</li>
              <li>KPI matrix by region against your targets</li>
              <li>Scheduled reports: daily, weekly, monthly or your own timing</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-erp" aria-labelledby="tab-erp" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/09-erp.webp"
                 src="/assets/products/erptick/09-erp.mp4"
                 aria-label="Video walkthrough with narration and captions: the ERPNext connection"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">ERPNext Connection</span>
              <h3>Connected to ERPNext, on Your Terms</h3>
              <p>An administrator adds the ERPNext connection on screen and tests it before saving. Master data flows in; draft invoices and stock entries go back only when you switch them on.</p>
            </div>
            <ul class="ticks">
              <li>Add and test the connection from the screen</li>
              <li>Keys stored encrypted and never shown again</li>
              <li>Choose what each connection is used for</li>
              <li>Sales invoices are always drafts, never submitted for you</li>
              <li>Every write-back tracked, with reasons and retries</li>
            </ul>
          </div>
        </div>

        <div class="tour-panel" role="tabpanel" id="panel-admin" aria-labelledby="tab-admin" hidden>
          <video class="tour-video" controls preload="none" playsinline width="1600" height="1000"
                 data-poster="/assets/products/erptick/posters/10-admin.webp"
                 src="/assets/products/erptick/10-admin.mp4"
                 aria-label="Video walkthrough with narration and captions: administration and security"></video>
          <div class="tour-copy">
            <div>
              <span class="kicker">Admin &amp; Security</span>
              <h3>Control Who Sees and Does What</h3>
              <p>Invite your team, shape roles with a permission grid, give partners a scoped API key and load customers in bulk, with every change recorded in an audit log.</p>
            </div>
            <ul class="ticks">
              <li>Custom roles with a permission grid and ticket scope</li>
              <li>Partner API keys with limited scopes</li>
              <li>Bulk import with a row-by-row preview</li>
              <li>Audit log that cannot be edited</li>
              <li>System monitor, search across screens, light and dark themes</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- ══ ERP FLOW ══ -->
  <section class="section" aria-labelledby="erp-flow">
    <div class="section-header">
      <h2 class="section-title" id="erp-flow">How It Works with ERPNext</h2>
      <div class="section-line"></div>
    </div>
    <p class="section-sub">ERPTick sits next to ERPNext, not on top of it. Your ERP keeps owning customers, items and accounts. ERPTick owns the service work.</p>
    <div class="flow">
      <div class="flow-step">
        <h3>Connect</h3>
        <p>An administrator adds your ERPNext site from the settings screen and runs a test. Credentials are encrypted at rest.</p>
        <ul class="ticks">
          <li>ERPNext REST with an API key</li>
          <li>Optional read-only database link for heavy reports</li>
        </ul>
      </div>
      <div class="flow-step">
        <h3>Sync</h3>
        <p>Customers, contacts, sites, machines by serial number, items, prices, warehouses and stock come into ERPTick.</p>
        <ul class="ticks">
          <li>Signed webhooks keep it current</li>
          <li>A nightly catch-up as a safety net</li>
        </ul>
      </div>
      <div class="flow-step">
        <h3>Write Back</h3>
        <p>Finished work goes back to your ERP so accounts and stores stay right. This happens only when you switch it on.</p>
        <ul class="ticks">
          <li>Draft sales invoices for chargeable tickets</li>
          <li>Stock entries for spares used on visits</li>
        </ul>
      </div>
    </div>
    <p class="flow-foot"><strong>Safe by default:</strong> every write-back is off until you turn it on, invoices are always created as drafts, and each one is protected against duplicates and retried if your ERP is unreachable.</p>
    <p class="flow-more">Built by the team behind our <a href="/services/erpnext-integration">ERPNext integration work</a>. See the <a href="/projects">case studies</a>.</p>
  </section>

  <!-- ══ CAPABILITIES ══ -->
  <section class="section" aria-labelledby="caps-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="caps-title">Built for Real Service Teams</h2>
      <div class="section-line"></div>
    </div>
    <div class="caps" style="margin-top:2rem;">
      <div class="cap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/></svg>
        <h3>SLA clocks that pause</h3>
        <p>Targets by coverage and priority on your working hours and holidays, paused while a ticket is on hold.</p>
      </div>
      <div class="cap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/></svg>
        <h3>Roles &amp; permissions</h3>
        <p>Create your own roles, choose what each can see and do, and limit tickets to a region or to their own work.</p>
      </div>
      <div class="cap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
        <h3>Email &amp; WhatsApp</h3>
        <p>Keep customers and engineers informed on the channel they actually read, with a log of every message sent.</p>
      </div>
      <div class="cap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
        <h3>Bulk import</h3>
        <p>Bring in customers and machines from CSV, with a validation preview before anything is saved.</p>
      </div>
      <div class="cap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13.5 5l-3 14"/></svg>
        <h3>Partner API</h3>
        <p>Let dealers or your own systems raise tickets through a secure API with keys you control.</p>
      </div>
      <div class="cap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
        <h3>Audit &amp; monitoring</h3>
        <p>An audit log of sensitive changes and a system monitor for queues, ERP requests and connections.</p>
      </div>
    </div>
  </section>

  <!-- ══ COMPARISON ══ -->
  <section class="section" aria-labelledby="compare-title" style="padding-top:0;">
    <div class="section-header">
      <h2 class="section-title" id="compare-title">ERPTick or Frappe Helpdesk?</h2>
      <div class="section-line"></div>
    </div>
    <div class="prose compare" style="margin-top:2rem;">
      <p>Frappe Helpdesk is a good open-source support desk for teams that answer customer questions by email and through a portal. ERPTick does a different job: service work that happens at the customer's site, on machines you sold. Here is how they compare, based on Frappe's own product page and README.</p>
      <table>
        <thead>
          <tr><th scope="col">What you need</th><th scope="col">ERPTick</th><th scope="col">Frappe Helpdesk</th></tr>
        </thead>
        <tbody>
          <tr><td>Tickets with SLA timers</td><td data-label="ERPTick">Yes. Response and resolution clocks run on your business calendar.</td><td data-label="Frappe Helpdesk">Yes. SLAs with response and resolution timers.</td></tr>
          <tr><td>Customer portal</td><td data-label="ERPTick">Yes. Customers raise and track tickets and approve quotations with their PO number.</td><td data-label="Frappe Helpdesk">Yes. Customers raise and track tickets and search a knowledge base.</td></tr>
          <tr><td>Field visits</td><td data-label="ERPTick">Engineers accept jobs, mark arrival, log spares, add photos and take the customer's signature.</td><td data-label="Frappe Helpdesk">Not listed.</td></tr>
          <tr><td>AMC contracts</td><td data-label="ERPTick">Cover period, machines covered and planned preventive visits, raised ahead of time.</td><td data-label="Frappe Helpdesk">Not listed.</td></tr>
          <tr><td>Machines and coverage</td><td data-label="ERPTick">Each machine by serial number, with AMC, warranty or chargeable cover.</td><td data-label="Frappe Helpdesk">Not listed.</td></tr>
          <tr><td>Quotations</td><td data-label="ERPTick">Built from your ERP items for chargeable work, with the customer's PO recorded.</td><td data-label="Frappe Helpdesk">Not listed.</td></tr>

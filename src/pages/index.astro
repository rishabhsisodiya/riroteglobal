---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseRow from '../components/CaseRow.astro';
import ContactPanel from '../components/ContactPanel.astro';
import ProductRow from '../components/ProductRow.astro';
import ServicePicker from '../components/ServicePicker.astro';
import { organization, website } from '../lib/schema';
import { COMPANY_STATS } from '../data/site';
import { CASES, PROJECTS_PATH } from '../data/cases';
import { PRODUCTS } from '../data/products';

// Stats strip under the hero: shared company numbers plus the reply-time promise made in the contact section.
const HERO_STATS = [COMPANY_STATS.projects, COMPANY_STATS.industries, COMPANY_STATS.regions, { value: '24h', label: 'Reply to Every Enquiry' }];

const seo = {
  title: 'Rirote Global | Software, AI & ERPNext Development in Jaipur',
  path: '/',
  description: 'Rirote Global builds full-stack products, AI agents and ERPNext integrations for businesses in India and worldwide. Based in Jaipur. Makers of ERPTick.',
  ogDescription: 'Websites, business software, AI assistants and ERPNext integration from a Jaipur team. Makers of ERPTick.',
  twitterDescription: 'Websites, business software, AI assistants and ERPNext integration from a Jaipur team.',
  schema: [organization(), website()],
};

const products = PRODUCTS.filter((p) => p.group === 'Products');
const openSource = PRODUCTS.filter((p) => p.group === 'Open source');

const roles = [
  ['Full-Stack Developer', 'React, Next.js, Node.js, TypeScript'],
  ['AI Engineer', 'LLM integration & agent workflows'],
  ['Backend Developer', 'NestJS, FastAPI, REST APIs'],
  ['ERP Integration Developer', 'ERPNext modules & integrations'],
  ['Cloud / DevOps Engineer', 'AWS, Docker, CI/CD, Nginx'],
  ['Technical Lead', 'Architecture & team leadership'],
];
const whyHire = [
  ['Tested first.', 'Every developer works on real projects with us before joining a client.'],
  ['Flexible.', 'Full-time, part-time or for one project, and you can change it later.'],
  ['Quick to start.', 'Developers are usually ready within a few days.'],
  ['Agency-friendly.', 'Agencies can use our developers under their own brand.'],
  ['India-based.', 'Fair rates, with experience on projects in the US and the Middle East.'],
  ['Managed by us.', "If something isn't working, we fix it."],
];
const reach = [
  ['India', 'Headquarters & Engineering Hub'],
  ['United States', 'Serving clients across North America'],
  ['Middle East', 'Serving clients across UAE & GCC'],
  ['Global', 'Remote-first delivery worldwide'],
];
const pillars = [
  ['Plan Before Building', 'We work out what has to change for your business, and the simplest way to get there, before any code is written.'],
  ['Built to Keep Running', 'Software that stays fast, secure and online as more people use it, with monitoring so problems are caught early.'],
  ['Tools That Fit the Job', "Modern tools, AI included, used where they make the work faster or cheaper for you, and left out where they don't."],
];
const stops: Array<[string, string]> = [['start', 'Start'], ['clients', 'Proof'], ['services', 'Built'], ['contact', 'Talk']];
---
<BaseLayout seo={seo} rail={{ stops }}>
<main id="main">

<section class="hero0" id="start">
  <div class="wrap">
    <p class="eyebrow">Rise with Robust Tech</p>
    <h1>We Build the Software &amp; AI <span>Your Business Runs&nbsp;On.</span></h1>
    <p class="page-sub">Rirote Global is a software company in Jaipur, India. We build websites and business software, add AI that works with your own data, and connect ERPNext to the rest of your tools. We also make ERPTick, a service desk for companies that sell and service machines.</p>
    <p class="cred">Built by engineers who have shipped for large clients around the world.</p>
    <div class="cta-row">
      <a href="#clients" class="btn-primary">See What We Have Solved</a>
      <a href="#contact" class="btn-outline">Tell Us Your Problem</a>
    </div>
    <div class="stats" aria-label="Rirote Global in numbers">
      {HERO_STATS.map((stat) => (
        <div><b data-count>{stat.value}</b><span>{stat.label}</span></div>
      ))}
    </div>
  </div>
</section>

<section class="band" id="clients">
  <div class="wrap">
    <div class="sec-h" data-reveal>
      <p class="eyebrow">Case Studies</p>
      <h2 class="section-title" style="margin-top:12px">Problems We Have Already Solved.</h2>
      <p class="section-sub">What changed for each business after we delivered, in numbers.</p>
    </div>
    <div class="ascents">{CASES.slice(0, 4).map((c) => <CaseRow study={c} />)}</div>
    <p class="seeall"><a class="btn-outline" href={PROJECTS_PATH}>All {CASES.length} case studies →</a></p>
  </div>
</section>

<section class="band dark" id="services">
  <div class="wrap">
    <div class="sec-h" data-reveal>
      <p class="eyebrow">What We Do</p>
      <h2 class="section-title" style="margin-top:12px">Our Services</h2>
      <p class="section-sub">From your first website to connecting your ERP. One team plans it, builds it and looks after it once it is live.</p>
    </div>
    <ServicePicker />
    <p class="seeall"><a class="btn-outline" href="/services">All services →</a></p>
  </div>
</section>

<section class="band dark" id="products" aria-labelledby="teaser-title" style="padding-top:0;border-top:none">
  <div class="wrap">
    <div class="sec-h" data-reveal>
      <p class="eyebrow">Our Products</p>
      <h2 class="section-title" id="teaser-title" style="margin-top:12px">Software We Build <span style="display:block">and Run Ourselves.</span></h2>
    </div>
    <div class="prows">{products.map((p) => <ProductRow product={p} />)}</div>
    <p class="seeall"><a class="btn-outline" href="/products">All products →</a></p>
  </div>
</section>

<section class="band" id="outsourcing">
  <div class="wrap">
    <div class="sec-h" data-reveal>
      <p class="eyebrow">Resource Outsourcing</p>
      <h2 class="section-title" style="margin-top:12px">Your Team, <span>Extended.</span></h2>
      <p class="section-sub">Experienced developers and specialists who join your team full-time or part-time. We vet them on real projects first and stay responsible for their work.</p>
    </div>
    <div class="two-col">
      <div data-reveal>
        <h3 class="h2s" style="font-size:1.5rem">Add People Without Hiring</h3>
        <p>Agencies use our developers when they have more work than staff. Startups use them to build a product, and larger companies to grow a team for a project.</p>
        <p style="margin-top:10px">You skip the long hiring process and the cost of a permanent hire.</p>
        <div class="roles" style="margin-top:20px">
          {roles.map(([name, desc]) => <div class="role"><h3>{name}</h3><p>{desc}</p></div>)}
        </div>
      </div>
      <div data-reveal>
        <h3 class="h2s" style="font-size:1.5rem">Why Hire Through Rirote Global?</h3>
        <ul class="why">{whyHire.map(([a, b]) => <li><strong>{a}</strong> {b}</li>)}</ul>
        <p style="margin-top:18px"><a class="btn-primary" href="/services/dedicated-engineers">Discuss Outsourcing →</a></p>
      </div>
    </div>
  </div>
</section>

<section class="band" id="reach">
  <div class="wrap">
    <div class="sec-h" data-reveal>
      <h2 class="section-title">Where We Work</h2>
      <p class="section-sub">We are based in Jaipur and work with clients in India, the United States and the Middle East, mostly remotely.</p>
    </div>
    <div class="reach">{reach.map(([a, b]) => <div data-reveal><b>{a}</b><span>{b}</span></div>)}</div>
  </div>
</section>

<section class="band" id="opensource">
  <div class="wrap">
    <div class="sec-h" data-reveal>
      <p class="eyebrow">Open Source</p>
      <h2 class="section-title" style="margin-top:12px">Built in the Open, <span>Free to Use.</span></h2>
      <p class="section-sub">Free tools and learning material we build for other engineers and give away.</p>
    </div>
    <div class="rel">
      {openSource.map((p) => (
        <a href={p.path} target={p.path.startsWith('http') ? '_blank' : undefined} rel={p.path.startsWith('http') ? 'noopener' : undefined} data-reveal>
          <b>{p.name}</b><span>{p.line}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="band" id="about">
  <div class="wrap">
    <div class="about">
      <div data-reveal>
        <p class="eyebrow">About Us</p>
        <h2 class="h2s" style="margin-top:12px">Engineers who have done this at scale, not just an agency.</h2>
        <p>Our engineers have worked at multinational companies and built applications for large clients around the world.</p>
        <p>Anyone can build a first version with AI now. Scaling it, designing the system and keeping it running is where experience counts. We understand what you need, plan it from that experience, and then deliver it.</p>
        <p style="margin-top:20px"><a class="btn-primary" href="/about">More about us →</a></p>
      </div>
      <ul class="ways" data-reveal>
        <li><b>Scaling</b><span>Knowing what breaks at ten times the users, before it does.</span></li>
        <li><b>System design</b><span>Data models and integrations that still make sense in two years.</span></li>
        <li><b>Security and running it</b><span>Handled from day one, and supported after launch.</span></li>
      </ul>
    </div>
    <div class="steps" style="margin-top:48px">
      {pillars.map(([a, b]) => <div class="step" data-reveal><h3>{a}</h3><p>{b}</p></div>)}
    </div>
  </div>
</section>

<section class="band dark" id="contact">
  <div class="wrap">
    <ContactPanel eyebrow="Get in Touch" title="Tell Us What You Need" note="You have reached the top. We are ready when you are."
      lead="Describe your project or the problem you want solved." />
  </div>
</section>

</main>
</BaseLayout>

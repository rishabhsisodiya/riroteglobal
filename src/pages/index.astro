<script is:inline slot="scripts">
// ── SCROLL REVEAL ──
(function () {
  const simple = ['.section-label', '.section-title', '.section-sub',
    '.about-content', '.about-nums', '.outsource-intro', '.outsource-why',
    '.contact-grid > div', '.teaser-card'];
  const left = ['.client-info', '.partner-info'];
  const right = ['.client-stats', '.partner-stat-panel'];
  const staggered = ['.services-grid', '.pillars', '.reach-grid', '.labs-grid', '.outsource-roles', '.about-nums'];

  simple.forEach(s => document.querySelectorAll(s).forEach(el => el.classList.add('sr')));
  left.forEach(s  => document.querySelectorAll(s).forEach(el => el.classList.add('sr','sr-left')));
  right.forEach(s => document.querySelectorAll(s).forEach(el => el.classList.add('sr','sr-right')));

  staggered.forEach(s => {
    const grid = document.querySelector(s);
    if (!grid) return;
    grid.classList.add('stagger');
    grid.querySelectorAll(':scope > *').forEach(child => child.classList.add('sr'));
  });

  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.sr').forEach(el => obs.observe(el));
})();

// ── NAV: frosted on scroll + active link highlight ──
// IntersectionObserver instead of a scroll handler: the browser reports what is in view, so
// scrolling never reads layout (no forced reflows).
const navEl = document.querySelector('nav');
const sections = Array.prototype.slice.call(document.querySelectorAll('section[id]'));
const navLinks = document.querySelectorAll('.nav-links a');

// Frosted nav once the page has scrolled 60px: a 60px sentinel at the top leaves the viewport.
const topSentinel = document.createElement('div');
topSentinel.setAttribute('aria-hidden', 'true');
topSentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:60px;pointer-events:none;';
document.body.prepend(topSentinel);
new IntersectionObserver(([e]) => navEl.classList.toggle('scrolled', !e.isIntersecting)).observe(topSentinel);

// Active link: the last section reaching into the top 22% of the viewport (about 200px on a laptop).
// A % margin, not innerHeight: reading the window size would itself force a layout.
const inBand = new Set();
let current = '';
function highlight(id) {
  if (id === current) return;
  current = id;
  navLinks.forEach(a => { a.style.color = a.getAttribute('href') === '#' + id ? 'var(--cyan)' : ''; });
}
const sectionObserver = new IntersectionObserver(entries => {
  let fallback = null;
  entries.forEach(e => {
    if (e.isIntersecting) { inBand.add(e.target); return; }
    inBand.delete(e.target);
    // Scrolled back up past this section's top: the section before it is current again.
    if (e.boundingClientRect.top > 0) {
      const i = sections.indexOf(e.target);
      fallback = i > 0 ? sections[i - 1].id : '';
    }
  });
  const visible = sections.filter(sec => inBand.has(sec));
  if (visible.length) highlight(visible[visible.length - 1].id);
  else if (fallback !== null) highlight(fallback);
}, { rootMargin: '0px 0px -78% 0px' });
sections.forEach(sec => sectionObserver.observe(sec));

// ── MOBILE MENU ──
document.getElementById('menuToggle').addEventListener('click', () => {
  const isOpen = document.getElementById('mobileMenu').classList.toggle('open');
  navEl.classList.toggle('menu-open', isOpen);
  document.getElementById('menuToggle').setAttribute('aria-expanded', String(isOpen));
});
document.querySelectorAll('.nav-links a').forEach(a => {
  a.addEventListener('click', () => {
    document.getElementById('mobileMenu').classList.remove('open');
    navEl.classList.remove('menu-open');
    document.getElementById('menuToggle').setAttribute('aria-expanded', 'false');
  });
});

// ── CONTACT FORM ──
// Submissions go to Web3Forms, which emails them to the address the access key was issued for.
// The key is public by design; get one at web3forms.com and paste it here.
const WEB3FORMS_KEY = 'd27d0242-b616-4b13-aa21-70fca7079ef7';
const WEB3FORMS_URL = 'https://api.web3forms.com/submit';
const CONTACT_FALLBACK = 'Please email us at <a href="mailto:info@riroteglobal.com">info@riroteglobal.com</a>.';
const contactForm = document.getElementById('contactForm');
if (contactForm) {
  const sendBtn = contactForm.querySelector('button[type="submit"]');
  const statusEl = document.getElementById('contactStatus');
  const sendLabel = sendBtn.textContent;
  const required = [
    ['name', 'Please enter your name.'],
    ['email', 'Please enter a valid email address.'],
    ['message', 'Please tell us a little about your project.'],
  ];
  const setStatus = (html, kind) => {
    statusEl.innerHTML = html;
    statusEl.className = 'contact-status' + (kind ? ' is-' + kind : '');
  };
  /** Marks invalid fields, focuses the first one and returns its message (or '' when the form is valid). */
  const validate = () => {
    let firstError = '';
    required.forEach(([name, message]) => {
      const field = contactForm.elements[name];
      field.value = field.value.trim();
      const ok = field.checkValidity();
      field.setAttribute('aria-invalid', String(!ok));
      if (!ok && !firstError) { firstError = message; field.focus(); }
    });
    return firstError;
  };
  contactForm.addEventListener('input', (e) => e.target.removeAttribute('aria-invalid'));
  contactForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sendBtn.disabled) return;
    const error = validate();
    if (error) return setStatus(error, 'error');
    if (!WEB3FORMS_KEY) return setStatus('The form is not connected yet. ' + CONTACT_FALLBACK, 'error');

    const data = Object.fromEntries(new FormData(contactForm));
    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending…';
    setStatus('', '');
    try {
      const res = await fetch(WEB3FORMS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          ...data,
          access_key: WEB3FORMS_KEY,
          subject: 'New enquiry from ' + data.name + ' · riroteglobal.com',
          from_name: 'Rirote Global website',
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok || !body.success) throw new Error(body.message || 'Request failed');
      contactForm.reset();
      setStatus('Thanks, your message has been sent. We will get back to you within 24 hours.', 'success');
    } catch (err) {
      // What the visitor typed stays in the form so they can retry.
      setStatus('Sorry, your message could not be sent. ' + CONTACT_FALLBACK, 'error');
    } finally {
      sendBtn.disabled = false;
      sendBtn.textContent = sendLabel;
    }
  });
}
</script>
</BaseLayout>

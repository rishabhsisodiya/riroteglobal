---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization, website } from '../lib/schema';
import { SERVICES, serviceUrl } from '../data/services';
import SocialLinks from '../components/SocialLinks.astro';

// One icon per service card; names and text come from src/data/services.ts.
const SERVICE_ICONS: Record<string, string> = {
  'full-stack-development': "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 8l-5 4 5 4M16 8l5 4-5 4M13.5 5l-3 14\"/></svg>",
  'ai-integration': "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11 3l1.9 5.1L18 10l-5.1 1.9L11 17l-1.9-5.1L4 10l5.1-1.9z\"/><path d=\"M18.5 15l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z\"/></svg>",
  'erpnext-integration': "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7.5\" height=\"7.5\" rx=\"1.2\"/><rect x=\"13.5\" y=\"3\" width=\"7.5\" height=\"7.5\" rx=\"1.2\"/><rect x=\"3\" y=\"13.5\" width=\"7.5\" height=\"7.5\" rx=\"1.2\"/><path d=\"M13.5 17.25h7.5M17.25 13.5V21\"/></svg>",
  'cloud-devops': "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 18.5a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 10.6a4 4 0 0 1 .2 7.9z\"/></svg>",
  'technical-leadership': "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M15.6 8.4l-2.1 5.1-5.1 2.1 2.1-5.1z\"/></svg>",
  'data-pipelines': "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 20.5h18M6.5 20.5V11M12 20.5V4.5M17.5 20.5v-7\"/></svg>",
  'dedicated-engineers': "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20a6.5 6.5 0 0 1 13 0M16 4.7a3.5 3.5 0 0 1 0 6.6M18.2 14.4A6.5 6.5 0 0 1 21.5 20\"/></svg>",
};

const seo = {
  title: 'Rirote Global | Software, AI & ERPNext Development in Jaipur',
  path: '/',
  description: 'Rirote Global builds full-stack products, AI agents and ERPNext integrations for businesses in India and worldwide. Based in Jaipur. Makers of ERPTick.',
  ogDescription: 'Websites, business software, AI assistants and ERPNext integration from a Jaipur team. Makers of ERPTick.',
  twitterDescription: 'Websites, business software, AI assistants and ERPNext integration from a Jaipur team.',
  schema: [organization(), website()],
};
---
<BaseLayout seo={seo} nav={false} siteCss={false}>
<Fragment slot="head">
<noscript><style>.hero-eyebrow, .hero-title, .hero-sub, .hero-btns, .hero-mark { opacity: 1 !important; }</style></noscript>
<style is:inline>
  /* Self-hosted fonts (latin subset). DM Sans is a variable font covering 300–700. */
  @font-face { font-family: 'Bebas Neue'; font-style: normal; font-weight: 400; font-display: swap; src: url(/assets/fonts/bebas-neue-v16-latin.woff2) format('woff2'); }
  @font-face { font-family: 'DM Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/dm-sans-v17-latin.woff2) format('woff2'); }
  @font-face { font-family: 'Space Mono'; font-style: normal; font-weight: 400; font-display: swap; src: url(/assets/fonts/space-mono-v17-latin-400.woff2) format('woff2'); }
  @font-face { font-family: 'Space Mono'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/space-mono-v17-latin-700.woff2) format('woff2'); }
  :root {
    --navy: #0a1628;
    --navy-mid: #0d1f3c;
    --cyan: #00b4d8;
    --electric: #0077b6;
    --blue-light: #48cae4;
    --white: #f0f4ff;
    --muted: #8899bb;
    --accent: #00d4ff;
    --gold: #ffd166;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--navy);
    color: var(--white);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    gap: 2rem;
    padding: 1rem 4rem;
    background: transparent;
    backdrop-filter: none;
    border-bottom: 1px solid transparent;
    transition: background 0.4s ease, backdrop-filter 0.4s ease, border-color 0.4s ease;
  }
  nav.scrolled {
    background: rgba(10,22,40,0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0,180,216,0.15);
  }
  nav.menu-open {
    background: rgba(10,22,40,0.97);
    backdrop-filter: blur(12px);
    border-bottom-color: rgba(0,180,216,0.15);
  }
  .nav-logo { flex-shrink: 0; }
  .nav-logo-link { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav-logo-mark { width: 38px; height: 38px; flex-shrink: 0; }
  .nav-logo-text { display: flex; flex-direction: column; line-height: 1; gap: 3px; }
  .nav-logo-brand {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.55rem; letter-spacing: 0.1em; line-height: 1;
    color: var(--white);
  }
  .nav-logo-brand span { color: var(--cyan); }
  .nav-logo-sub {
    font-family: 'Space Mono', monospace;
    font-size: 0.44rem; letter-spacing: 0.32em;
    color: var(--muted); text-transform: uppercase;
  }
  .menu-toggle { display: none; }
  .nav-links {
    display: flex; gap: 2rem; list-style: none;
    flex: 1; justify-content: center;
  }
  .nav-links a {
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
    white-space: nowrap;
  }
  .nav-links a:hover { color: var(--cyan); }
  .nav-cta-wrap { flex-shrink: 0; }
  .nav-cta {
    display: inline-block;
    background: linear-gradient(135deg, var(--electric), var(--cyan));
    color: var(--navy) !important;
    padding: 0.55rem 1.4rem;
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  /* ── HERO ── */
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3.5rem; align-items: center;
    padding: 9rem 4rem 6rem;
    position: relative;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 60% at 70% 50%, rgba(0,119,182,0.18) 0%, transparent 70%),
                radial-gradient(ellipse 40% 40% at 10% 80%, rgba(0,180,216,0.08) 0%, transparent 60%);
  }
  .hero-content { position: relative; z-index: 2; }
  .hero-logo {
    height: 120px;
    margin-bottom: 2rem;
    opacity: 0; animation: fadeUp 0.8s 0s forwards;
  }
  .hero-eyebrow {
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.25em;
    color: var(--cyan);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0; animation: fadeUp 0.8s 0.2s forwards;
  }
  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 4.4vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: 0.03em;
    margin-bottom: 1.8rem;
    opacity: 0; animation: fadeUp 0.8s 0.4s forwards;
  }
  .hero-title span { color: var(--blue-light); }
  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(240,244,255,0.72);
    max-width: 560px;
    margin-bottom: 2.8rem;
    opacity: 0; animation: fadeUp 0.8s 0.6s forwards;
  }
  .hero-btns { display: flex; gap: 1rem; opacity: 0; animation: fadeUp 0.8s 0.8s forwards; }
  .btn-primary {
    background: linear-gradient(135deg, var(--electric), var(--cyan));
    color: var(--navy);
    padding: 1rem 2.2rem;
    border: none; border-radius: 5px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700; font-size: 0.95rem;
    cursor: pointer; text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,180,216,0.35); }
  .btn-ghost {
    color: var(--white); padding: 1rem 2.2rem;
    border: 1px solid rgba(0,180,216,0.4);
    border-radius: 5px; font-size: 0.95rem;
    cursor: pointer; text-decoration: none;
    transition: border-color 0.3s, background 0.3s;
  }
  .btn-ghost:hover { border-color: var(--cyan); background: rgba(0,180,216,0.08); }

  /* Brand mark beside the hero text, with three slowly turning rings. Each ring carries one dot so
     the turn is visible; there are no particles or other motion. Reduced-motion users see it still. */
  .hero-mark {
    position: relative; z-index: 1; justify-self: center;
    width: min(500px, 100%); aspect-ratio: 1;
    opacity: 0; animation: fadeUp 0.8s 0.5s forwards;
  }
  .hero-mark img {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 132px; height: auto; opacity: 0.3;
  }
  .orbit-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(0,180,216,0.2); }
  .orbit-ring::after {
    content: ''; position: absolute; top: -4px; left: 50%; width: 8px; height: 8px; margin-left: -4px;
    border-radius: 50%; background: var(--cyan); box-shadow: 0 0 12px var(--cyan);
  }
  .ring1 { inset: 0; animation: spin 40s linear infinite; }
  .ring2 { inset: 12.5%; animation: spinR 30s linear infinite; }
  .ring2::after { width: 6px; height: 6px; margin-left: -3px; top: -3px; opacity: 0.7; }
  .ring3 { inset: 25%; border-color: rgba(0,180,216,0.35); animation: spin 22s linear infinite; }
  .ring3::after { width: 5px; height: 5px; margin-left: -2.5px; top: -2.5px; opacity: 0.6; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes spinR { to { transform: rotate(-360deg); } }

  /* ── PILLARS ── */
  .pillars {
    padding: 6rem 4rem;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
    background: rgba(0,180,216,0.08);
    border-top: 1px solid rgba(0,180,216,0.15);
    border-bottom: 1px solid rgba(0,180,216,0.15);
  }
  .pillar {
    padding: 3rem 2.5rem;
    background: var(--navy);
    transition: background 0.3s;
  }
  .pillar:hover { background: rgba(0,119,182,0.12); }
  .pillar-title {
    font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.35rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.8rem;
  }
  .pillar p { font-size: 0.95rem; color: rgba(240,244,255,0.65); line-height: 1.7; }

  /* ── SERVICES ── */
  .section { padding: 7rem 4rem; }
  .section-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    color: var(--cyan);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .section-title {
    font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: clamp(2rem, 3.4vw, 2.8rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }
  .section-sub {
    color: rgba(240,244,255,0.6);
    font-size: 1.05rem;
    max-width: 580px;
    line-height: 1.7;
    margin-bottom: 3.5rem;
  }

  .services-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5px;
    background: rgba(0,180,216,0.1);
    border: 1px solid rgba(0,180,216,0.1);
  }
  .service-card {
    background: var(--navy-mid);
    padding: 2.5rem;
    transition: background 0.3s;
    position: relative; overflow: hidden;
  }
  .service-card::before {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    transform: scaleX(0); transition: transform 0.4s;
  }
  .service-card:hover { background: rgba(0,119,182,0.15); }
  .service-card:hover::before { transform: scaleX(1); }
  .service-icon { margin-bottom: 1.1rem; color: var(--cyan); line-height: 0; }
  .service-icon svg { width: 36px; height: 36px; }
  .service-name {
    font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.3rem; letter-spacing: -0.01em;
    margin-bottom: 0.6rem;
    color: var(--white);
  }
  .service-card p { font-size: 0.9rem; color: rgba(240,244,255,0.6); line-height: 1.65; }
  .service-more {
    display: inline-block; margin-top: 1rem; position: relative;
    font-family: 'Space Mono', monospace; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cyan); text-decoration: none;
  }
  .service-more:hover { color: var(--white); }

  /* ── PRODUCT TEASER ── */
  .teaser-section { padding: 0 4rem 7rem; }
  .teaser-card {
    --sb: #34d399;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    border: 1px solid rgba(52,211,153,0.3); border-radius: 10px; overflow: hidden;
    background: linear-gradient(135deg, rgba(16,185,129,0.1), rgba(13,31,60,0.9) 55%);
  }
  .teaser-info { padding: 3.5rem; display: flex; flex-direction: column; gap: 1.2rem; }
  .teaser-badge {
    align-self: flex-start;
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--sb);
    background: rgba(16,185,129,0.12); border: 1px solid rgba(52,211,153,0.35);
    padding: 0.3rem 0.8rem; border-radius: 3px;
  }
  .teaser-badge::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--sb); }
  .teaser-name {
    font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: clamp(2rem, 3vw, 2.6rem);
    letter-spacing: -0.01em; line-height: 1.2;
  }
  .teaser-name span { color: var(--sb); }
  .teaser-info p { color: rgba(240,244,255,0.72); font-size: 1rem; line-height: 1.75; max-width: 52ch; }
  .teaser-points { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .teaser-points li {
    position: relative; padding-left: 1.5rem;
    color: rgba(240,244,255,0.85); font-size: 0.95rem; line-height: 1.5;
  }
  .teaser-points li::before {
    content: ''; position: absolute; left: 0; top: 0.35rem;
    width: 0.75rem; height: 0.4rem;
    border-left: 2px solid var(--sb); border-bottom: 2px solid var(--sb); transform: rotate(-45deg);
  }
  .teaser-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.6rem; }
  .teaser-actions .btn-primary { background: linear-gradient(135deg, #059669, #34d399); color: #04120d; }
  .teaser-actions .btn-ghost { border-color: rgba(52,211,153,0.4); }
  .teaser-shot {
    display: block; position: relative;
    border-left: 1px solid rgba(52,211,153,0.2);
    background: #0b1a30;
  }
  .teaser-shot img {
    width: 100%; height: 100%; min-height: 100%;
    object-fit: cover; object-position: top left; display: block;
  }
  .teaser-play {
    position: absolute; right: 1.25rem; bottom: 1.25rem;
    display: inline-flex; align-items: center; gap: 0.55rem;
    background: rgba(10,22,40,0.88); color: var(--white);
    border: 1px solid rgba(52,211,153,0.4); border-radius: 999px;
    padding: 0.6rem 1.1rem;
    font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .teaser-play svg { width: 12px; height: 12px; color: var(--sb); }

  /* ── CLIENT SHOWCASE ── */
  .clients-section {
    padding: 7rem 4rem;
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-mid) 100%);
  }
  .client-card {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid rgba(0,180,216,0.2);
    overflow: hidden;
    margin-top: 3rem;
  }
  .client-info {
    padding: 4rem;
    background: rgba(0,119,182,0.08);
    border-right: 1px solid rgba(0,180,216,0.15);
  }
  .client-badge {
    display: inline-block;
    background: rgba(0,180,216,0.15);
    border: 1px solid rgba(0,180,216,0.3);
    color: var(--cyan);
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; letter-spacing: 0.2em;
    padding: 0.3rem 0.8rem;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    border-radius: 2px;
  }
  .client-name {
    font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 2.2rem; letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }
  .client-tagline {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem; letter-spacing: 0.1em;
    color: var(--cyan); margin-bottom: 1.5rem;
  }
  .client-info p { font-size: 0.95rem; color: rgba(240,244,255,0.65); line-height: 1.75; margin-bottom: 1rem; }
  .client-services { margin: 2rem 0; }
  .client-service-tag {
    display: inline-block;
    background: rgba(0,119,182,0.2);
    border: 1px solid rgba(0,119,182,0.4);
    color: var(--blue-light);
    font-size: 0.78rem; padding: 0.3rem 0.9rem;
    margin: 0.25rem 0.25rem 0.25rem 0;
    border-radius: 3px;
  }
  .client-link {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: var(--cyan); text-decoration: none;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem; letter-spacing: 0.1em;
    margin-top: 1.5rem;
    transition: gap 0.2s;
  }
  .client-link:hover { gap: 0.9rem; }

  .client-stats {
    padding: 4rem;
    display: flex; flex-direction: column; justify-content: center; gap: 2.5rem;
  }
  .stat-item {}
  .stat-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3.5rem;
    color: var(--cyan);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.85rem; color: rgba(240,244,255,0.55);
    margin-top: 0.3rem;
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    letter-spacing: 0.1em; text-transform: uppercase;
  }
  .stat-divider {
    height: 1px;
    background: linear-gradient(90deg, rgba(0,180,216,0.3), transparent);
  }
  .worked-with {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.5rem;
    margin-top: 3rem; padding-top: 2rem;
    border-top: 1px solid rgba(0,180,216,0.15);
  }
  .worked-with-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; letter-spacing: 0.2em;
    color: var(--muted); text-transform: uppercase;
  }
  .worked-with-name {
    font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em;
    color: rgba(240,244,255,0.55); text-decoration: none;
    transition: color 0.2s;
  }
  .worked-with-name:hover { color: var(--cyan); }

  /* ── PARTNER BADGE VARIANT ── */
  .partner-badge {
    display: inline-block;
    background: rgba(255,209,102,0.12);
    border: 1px solid rgba(255,209,102,0.4);
    color: var(--gold);
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem; letter-spacing: 0.2em;
    padding: 0.3rem 0.8rem;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    border-radius: 2px;
  }

  /* ── OUTSOURCING SECTION ── */
  .outsourcing-section {
    padding: 7rem 4rem;
    background: var(--navy-mid);
    border-top: 1px solid rgba(0,180,216,0.12);
  }
  .outsource-grid {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 5rem;
    align-items: center; margin-top: 3.5rem;
  }
  .outsource-intro h3 {
    font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.5rem; letter-spacing: -0.01em;
    color: var(--white); margin-bottom: 1rem;
  }
  .outsource-intro p { font-size: 0.95rem; color: rgba(240,244,255,0.65); line-height: 1.8; margin-bottom: 1rem; }
  .outsource-roles {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1px;
    background: rgba(0,180,216,0.1);
    border: 1px solid rgba(0,180,216,0.1);
    margin-top: 2rem;
  }
  .role-card {
    padding: 1.5rem;
    background: var(--navy);
    transition: background 0.3s;
  }
  .role-card:hover { background: rgba(0,119,182,0.12); }
